datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  name          String
  role          String    // "SUPER_ADMIN", "SCHOOL_ADMIN", "TEACHER", "STUDENT", "PARENT"
  schoolId      String?   // Null for SUPER_ADMIN
  school        School?   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  avatar        String?
  phoneNumber   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Role-specific relations
  studentProfile Student?
  teacherProfile Teacher?
  parentProfile  Parent?
  auditLogs      AuditLog[]
  notifications  Notification[]
}

model School {
  id             String    @id @default(uuid())
  name           String
  slug           String    @unique // Custom subdomain/URL: school-slug
  logo           String?
  themeColor     String    @default("#1e40af") // Royal Blue default
  tagline        String?
  about          String?
  isActive       String    @default("active") // "active", "blocked"
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  users          User[]
  sessions       Session[]
  classes        Class[]
  courses        Course[]
  fees           Fee[]
  announcements  Announcement[]
}

model Subscription {
  id          String   @id @default(uuid())
  name        String   // "Starter", "Pro", "Enterprise"
  price       Float
  duration    String   // "monthly", "yearly"
  maxStudents Int
  maxTeachers Int
  features    String   // JSON string of enabled features
  schools     School[]
}

model Teacher {
  id             String    @id @default(uuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payrollSalary  Float     @default(0.0)
  bio            String?
  qualifications String?

  subjects       Subject[]
  classes        Class[]   @relation("ClassFormTeacher")
}

model Student {
  id           String    @id @default(uuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentId    String    @unique // Auto-generated ID (e.g., CN-2026-0001)
  parentId     String?
  parent       Parent?   @relation(fields: [parentId], references: [id], onDelete: SetNull)
  classId      String?
  class        Class?    @relation(fields: [classId], references: [id], onDelete: SetNull)

  enrollments  Enrollment[]
  progress     LessonProgress[]
  attempts     ExamAttempt[]
  submissions  AssignmentSubmission[]
  attendance   Attendance[]
  results      Result[]
  reportCards  ReportCard[]
  certificates Certificate[]
}

model Parent {
  id        String    @id @default(uuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  students  Student[]
}

model Session {
  id        String   @id @default(uuid())
  name      String   // e.g., "2025/2026"
  isCurrent Boolean  @default(false)
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  terms     Term[]
}

model Term {
  id        String   @id @default(uuid())
  name      String   // e.g., "First Term", "Second Term"
  isCurrent Boolean  @default(false)
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  classes   Class[]
  exams     Exam[]
}

model Class {
  id            String    @id @default(uuid())
  name          String    // e.g., "Grade 10-A"
  schoolId      String
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  termId        String?
  term          Term?     @relation(fields: [termId], references: [id], onDelete: SetNull)
  formTeacherId String?
  formTeacher   Teacher?  @relation("ClassFormTeacher", fields: [formTeacherId], references: [id], onDelete: SetNull)

  students      Student[]
  subjects      Subject[]
  timetable     String?   // JSON string of weekly slots
}

model Subject {
  id        String   @id @default(uuid())
  name      String   // e.g., "Mathematics"
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  
  exams     Exam[]
  assignments Assignment[]
  materials Material[]
}

// ==========================================
// PACE LEARNING MODELS
// ==========================================

model Course {
  id          String   @id @default(uuid())
  title       String
  description String
  coverImage  String?
  price       Float    @default(0.0) // If paid course
  isPublished Boolean  @default(false)
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  modules     CourseModule[]
  enrollments Enrollment[]
  certificates Certificate[]
  exams        Exam[]        @relation("CourseFinalExam")
}

model CourseModule {
  id       String   @id @default(uuid())
  title    String   @default("Untitled Module")
  order    Int
  courseId String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons  Lesson[]
}

model Lesson {
  id       String   @id @default(uuid())
  title    String
  content  String?  // Rich text or markdown
  videoUrl String?  // YouTube/Vimeo private link
  pdfUrl   String?  // File path/URL
  duration Int      @default(0) // in minutes
  order    Int
  moduleId String
  module   CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  
  progress LessonProgress[]
}

model Enrollment {
  id         String   @id @default(uuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress   Float    @default(0.0) // Percentage 0-100
  isCompleted Boolean @default(false)
  enrolledAt DateTime @default(now())
}

model LessonProgress {
  id          String   @id @default(uuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  isCompleted Boolean  @default(true)
  completedAt DateTime @default(now())

  @@unique([studentId, lessonId])
}

// ==========================================
// CBT EXAM SYSTEM MODELS
// ==========================================

model Exam {
  id            String   @id @default(uuid())
  title         String
  instructions  String?
  duration      Int      // in minutes
  startTime     DateTime?
  endTime       DateTime?
  shuffle       Boolean  @default(false)
  showResult    Boolean  @default(true)
  isActive      Boolean  @default(true)
  
  // Relations
  subjectId     String?
  subject       Subject? @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  courseId      String?  @unique
  course        Course?  @relation("CourseFinalExam", fields: [courseId], references: [id], onDelete: Cascade)
  termId        String?
  term          Term?    @relation(fields: [termId], references: [id], onDelete: Cascade)

  questions     Question[]
  attempts      ExamAttempt[]
  results       Result[]
}

model Question {
  id            String   @id @default(uuid())
  examId        String
  exam          Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  type          String   // "MCQ", "TRUE_FALSE", "SHORT_ANSWER", "THEORY"
  questionText  String
  imageUrl      String?
  options       String?  // JSON array for MCQ (e.g., ["A", "B", "C", "D"])
  correctAnswer String?  // Correct option or keyword
  points        Float    @default(1.0)

  answers       Answer[]
}

model ExamAttempt {
  id          String   @id @default(uuid())
  examId      String
  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  score       Float    @default(0.0)
  isGraded    Boolean  @default(false)
  startedAt   DateTime @default(now())
  submittedAt DateTime?
  
  answers     Answer[]
  results     Result[]
}

model Answer {
  id          String   @id @default(uuid())
  attemptId   String
  attempt     ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId  String
  question    Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  studentAnswer String
  score       Float    @default(0.0)
  isGraded    Boolean  @default(false)
  feedback    String?
}

// ==========================================
// ACADEMIC RECORDS / ACTIVE LEARNING
// ==========================================

model Assignment {
  id          String   @id @default(uuid())
  title       String
  description String
  dueDate     DateTime
  fileUrl     String?
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  submissions AssignmentSubmission[]
}

model AssignmentSubmission {
  id           String   @id @default(uuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  submissionText String?
  fileUrl      String?
  submittedAt  DateTime @default(now())
  score        Float?
  feedback     String?
}

model Attendance {
  id          String   @id @default(uuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date        DateTime
  status      String   // "PRESENT", "ABSENT", "LATE", "EXCUSED"
  remarks     String?

  @@unique([studentId, date])
}

model Result {
  id          String   @id @default(uuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  examId      String
  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  attemptId   String
  attempt     ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  totalScore  Float
  grade       String
  remarks     String?
}

model ReportCard {
  id          String   @id @default(uuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  termName    String
  sessionName String
  gpa         Float
  remarks     String?
  pdfUrl      String?
  createdAt   DateTime @default(now())
}

model Certificate {
  id          String   @id @default(uuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  certificateCode String @unique
  issuedAt    DateTime @default(now())
}

// ==========================================
// FEES & BILLING
// ==========================================

model Fee {
  id          String   @id @default(uuid())
  title       String
  amount      Float
  dueDate     DateTime
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  payments    Payment[]
}

model Payment {
  id          String   @id @default(uuid())
  feeId       String
  fee         Fee      @relation(fields: [feeId], references: [id], onDelete: Cascade)
  studentId   String
  amountPaid  Float
  status      String   // "PAID", "UNPAID", "PARTIALLY_PAID"
  reference   String   @unique
  paidAt      DateTime @default(now())
}

// ==========================================
// SYSTEM-WIDE MODELS
// ==========================================

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Announcement {
  id        String   @id @default(uuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title     String
  content   String
  target    String   // "ALL", "TEACHERS", "STUDENTS", "PARENTS"
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  details   String
  ipAddress String?
  createdAt DateTime @default(now())
}

model Material {
  id        String   @id @default(uuid())
  title     String
  fileUrl   String
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}
